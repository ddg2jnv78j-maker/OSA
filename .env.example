# ============================================================
# OSA — Real-Time Messaging Application Environment Variables
# ============================================================

# Supabase Configuration (Required for production database, auth, storage, and realtime)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# Google Gemini AI Configuration (Configured via GitHub Actions Secrets)
VITE_GOOGLE_AI_API_KEY="your-google-ai-api-key"

# WebRTC STUN / TURN Public Configuration (Optional - defaults to public Google STUN if omitted)
# IMPORTANT: Never place private server secrets here. Use public or ephemeral TURN credentials.
VITE_WEBRTC_STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
VITE_WEBRTC_TURN_URL=""
VITE_WEBRTC_TURN_USERNAME=""
VITE_WEBRTC_TURN_CREDENTIAL=""

# Browser Push Notifications (Optional - Web Push Public VAPID Key)
VITE_VAPID_PUBLIC_KEY=""

# Application Metadata
VITE_APP_NAME="OSA"
VITE_APP_VERSION="1.0.0"
